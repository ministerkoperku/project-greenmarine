        Triangle t=triangles[hit.primitive];vec3 normal=normalize(cross(t.b.xyz-t.a.xyz,t.c.xyz-t.a.xyz));
        if(dot(normal,direction)>0) normal=-normal;
        vec3 pos=origin+direction*hit.distance;
        vec3 base=pow(max(surface(t,hit.bary).rgb,vec3(0)),vec3(2.2));
        vec3 sun=normalize(Sun.xyz);float diffuse=max(dot(normal,sun),0.0);
        bool occluded=Sun.w>0 && diffuse>0 && trace(pos+normal*.025,sun,32.0).found;
        // Store irradiance independently of texture color. Filtering radiance/albedo ratios amplifies dark texels.
        vec3 irradiance=vec3(Options.x+(occluded?0.0:diffuse*Sun.w));
        irradiance+=vec3(t.uv2.w*.45);
