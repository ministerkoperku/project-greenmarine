#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform accelerationStructureEXT World;
struct Triangle { vec4 a; vec4 b; vec4 c; vec4 uv01; vec4 uv2; vec4 tint; };
layout(std430,set=0,binding=1) readonly buffer Geometry { Triangle triangles[]; };
layout(std430,set=0,binding=2) buffer Output { uint pixels[]; };
layout(std140,set=0,binding=3) uniform TraceFrame {
    mat4 InverseProjection; mat4 InverseView; mat4 Projection; mat4 View;
    vec4 Camera; vec4 Viewport; vec4 Sun; vec4 Options;
};
layout(set=0,binding=4) uniform sampler2D Atlas;
vec2 triangleUV(Triangle t,vec2 bary) { return t.uv01.xy*(1.0-bary.x-bary.y)+t.uv01.zw*bary.x+t.uv2.xy*bary.y; }
vec4 surface(Triangle t,vec2 bary) { return textureLod(Atlas,triangleUV(t,bary),0.0)*vec4(t.tint.rgb,1); }
struct Hit { bool found; float distance; uint primitive; vec2 bary; };
Hit trace(vec3 origin,vec3 direction,float reach) {
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray,World,gl_RayFlagsNoneEXT,255,origin,.015,direction,reach);
    while(rayQueryProceedEXT(ray)) {
        if(rayQueryGetIntersectionTypeEXT(ray,false)==gl_RayQueryCandidateIntersectionTriangleEXT) {
            uint index=rayQueryGetIntersectionPrimitiveIndexEXT(ray,false);
            Triangle t=triangles[index];
            if(t.uv2.z<.5 || surface(t,rayQueryGetIntersectionBarycentricsEXT(ray,false)).a>.1) rayQueryConfirmIntersectionEXT(ray);
        }
    }
    Hit hit;hit.found=rayQueryGetIntersectionTypeEXT(ray,true)==gl_RayQueryCommittedIntersectionTriangleEXT;
    hit.distance=hit.found?rayQueryGetIntersectionTEXT(ray,true):reach;
    hit.primitive=hit.found?rayQueryGetIntersectionPrimitiveIndexEXT(ray,true):0;
    hit.bary=hit.found?rayQueryGetIntersectionBarycentricsEXT(ray,true):vec2(0);
