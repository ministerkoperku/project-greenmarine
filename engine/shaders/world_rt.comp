            vec3 tangent=normalize(abs(normal.y)<.9?cross(normal,vec3(0,1,0)):cross(normal,vec3(1,0,0)));
            vec3 bitangent=cross(normal,tangent);vec3 incoming=vec3(0);
            for(int bounceIndex=0;bounceIndex<4;bounceIndex++) {
                float seed=dot(floor((pos.xz+Options.zw)*4.0),vec2(17.0,59.0));
                float a=6.2831853*(float(bounceIndex)+hash(seed))/4.0;
                float r=sqrt((float(bounceIndex)+.5)/4.0);
