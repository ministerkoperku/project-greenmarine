      "name": "solstice_scene",
      "fragment": "greenmarine:core/solstice_scene",
      "format": "rgba16f"
    },
    {
      "name": "solstice_bloom",
      "fragment": "greenmarine:core/solstice_bloom",
      "scale": 0.5,
      "format": "rgba16f",
      "minQuality": "medium",
      "inputs": {
