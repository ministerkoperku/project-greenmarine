      }
    },
    {
      "name": "solstice_compose",
      "fragment": "greenmarine:core/solstice_compose",
      "requires": "hardware_rt",
      "fallback": "greenmarine:core/solstice_compose",
      "history": true,
      "lightingHistory": true,
      "inputs": {
        "SolsticeScene": "solstice_scene"
      }
    }
